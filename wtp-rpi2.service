[Unit]
Description=WTP RPi2 Sensor Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/RENO-RPI2
ExecStart=/usr/bin/python3 /home/pi/RENO-RPI2/main.py
Restart=always
RestartSec=10
StandardOutput=append:/home/pi/RENO-RPI2/wtp-rpi2.log
StandardError=append:/home/pi/RENO-RPI2/wtp-rpi2.log

[Install]
WantedBy=multi-user.target
