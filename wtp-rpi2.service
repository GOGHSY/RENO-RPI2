[Unit]
Description=WTP RPi2 Sensor Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/MQTTsystem
ExecStart=/usr/bin/python3 /home/pi/MQTTsystem/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
